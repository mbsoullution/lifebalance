msgstr "Все"

msgid "План"
msgstr "План"

msgid "Від"
msgstr "От"

msgid "До"
msgstr "До"

msgid "Показати"
msgstr "Показать"

msgid "Акція увімкнена"
msgstr "Акция включена"

msgid "Ліміт місць"
msgstr "Лимит мест"

msgid "Початок"
msgstr "Начало"

msgid "Кінець"
msgstr "Конец"

msgid "Оплачено місць"
msgstr "Оплачено мест"

msgid "Зарезервовано зараз"
msgstr "Зарезервировано сейчас"

msgid "Кінець раніше за початок."
msgstr "Конец раньше начала."

msgid "Акцію збережено."
msgstr "Акция сохранена."

msgid "Позначка спору завершує доступ із цієї оплати. Зрізи і цілі залишаються."
msgstr "Отметка спора завершает доступ из этой оплаты. Срезы и цели остаются."

msgid "Це замовлення не можна позначити спором."
msgstr "Этот заказ нельзя отметить спором."

msgid "Позначити спір"
msgstr "Отметить спор"

msgid "Спір не позначено."
msgstr "Спор не отмечен."

msgid "Спір позначено, доступ завершено."
msgstr "Спор отмечен, доступ завершен."

msgid "Повне повернення @price грн за «@plan». Часткове повернення тут не оформлюється."
msgstr "Полный возврат @price грн за «@plan». Частичный возврат здесь не оформляется."

msgid "Це замовлення не можна повернути звідси."
msgstr "Этот заказ нельзя вернуть отсюда."

msgid "Повернути"
msgstr "Вернуть"

msgid "Повернення не прийнято."
msgstr "Возврат не принят."

msgid "Оплату повернено."
msgstr "Оплата возвращена."

msgid "Повернення надіслано. Статус оновиться після підтвердження."
msgstr "Возврат отправлен. Статус обновится после подтверждения."

msgid "@price грн за @days днів"
msgstr "@price грн за @days дней"

msgid "Наступні 30 днів коштують @price грн."
msgstr "Следующие 30 дней стоят @price грн."

msgid "Акційні місця закінчились. Ціна 149 грн за 30 днів"
msgstr "Акционные места закончились. Цена 149 грн за 30 дней"

msgid "Підтверджую оплату 149 грн за 30 днів"
msgstr "Подтверждаю оплату 149 грн за 30 дней"

msgid "Підтвердьте оплату 149 грн за 30 днів."
msgstr "Подтвердите оплату 149 грн за 30 дней."

msgid "Доступ до @date включно."
msgstr "Доступ до @date включительно."

msgid "Оплата почнеться @date, після поточного доступу."
msgstr "Оплата начнется @date, после текущего доступа."

msgid "Автопродовження немає."
msgstr "Автопродления нет."

msgid "Збережені зрізи, відповіді, цілі й плани лишаються."
msgstr "Сохраненные срезы, ответы, цели и планы остаются."

msgid "Нові розширені дії будуть недоступні."
msgstr "Новые расширенные действия будут недоступны."

msgid "Умови повернення"
msgstr "Условия возврата"

msgid "Безстроковий доступ уже є, тож нова оплата не потрібна."
msgstr "Бессрочный доступ уже есть, поэтому новая оплата не нужна."

msgid "Забагато спроб оплати. Спробуйте пізніше."
msgstr "Слишком много попыток оплаты. Попробуйте позже."

msgid "Перейти до оплати"
msgstr "Перейти к оплате"

msgid "Частину оплати повернено. Доступ можна завершити вручну. Зрізи і цілі залишаються."
msgstr "Часть оплаты возвращена. Доступ можно завершить вручную. Срезы и цели остаются."

msgid "Для цього замовлення рішення вже не потрібне."
msgstr "Для этого заказа решение уже не нужно."

msgid "Причина"
msgstr "Причина"

msgid "Скасувати доступ"
msgstr "Отменить доступ"

msgid "Вкажіть причину."
msgstr "Укажите причину."

msgid "Доступ не завершено."
msgstr "Доступ не завершен."

msgid "Доступ із цієї оплати завершено."
msgstr "Доступ из этой оплаты завершен."

msgid "Оплату зараховано."
msgstr "Оплата зачислена."

msgid "Оплата обробляється, ми надішлемо лист."
msgstr "Оплата обрабатывается, мы отправим письмо."

msgid "Оплату не завершено."
msgstr "Оплата не завершена."

msgid "Частину оплати повернено."
msgstr "Часть оплаты возвращена."

msgid "Перевіряємо оплату… Якщо підтвердження затримується, лист надійде після обробки."
msgstr "Проверяем оплату… Если подтверждение задерживается, письмо придет после обработки."

msgid "Орієнтир перераховується на сервері."
msgstr "Ориентир пересчитывается на сервере."

msgid "Версія каталогу записується на сервері."
msgstr "Версия каталога записывается на сервере."

msgid "Кожен активний сектор має оцінку."
msgstr "У каждого активного сектора есть оценка."

msgid "Оцінка сектору повторюється."
msgstr "Оценка сектора повторяется."

msgid "Оцінка вказує на невідомий або вимкнений сектор."
msgstr "Оценка указывает на неизвестный или выключенный сектор."

msgid "Відповідь на критерій повторюється."
msgstr "Ответ на критерий повторяется."

msgid "Відповідь приймається лише для опублікованого критерію з поточною ревізією."
msgstr "Ответ принимается только для опубликованного критерия с текущей ревизией."

msgid "Відповідь стосується сектору, якого немає серед активних."
msgstr "Ответ относится к сектору, которого нет среди активных."

msgid "Відповідь на розширений критерій потребує доступу до розширеного оцінювання."
msgstr "Ответ на расширенный критерий требует доступа к расширенной оценке."

msgid "Нотатка може містити не більше 1000 символів."
msgstr "Заметка может содержать не больше 1000 символов."

msgid "Нотатка"
msgstr "Заметка"

msgid "Зберегти нотатку"
msgstr "Сохранить заметку"

msgid "Нотатка може містити до 1000 символів."
msgstr "Заметка может содержать до 1000 символов."

msgid "Нотатку не збережено."
msgstr "Заметка не сохранена."

msgid "Нотатку збережено."
msgstr "Заметка сохранена."

msgid "Будь-яка"
msgstr "Любая"

msgid "Хто, UID"
msgstr "Кто, UID"

msgid "Кому, UID"
msgstr "Кому, UID"

msgid "Що"
msgstr "Что"

msgid "Знайти"
msgstr "Найти"

msgid "Видалити акаунт і всі збережені зрізи?"
msgstr "Удалить аккаунт и все сохраненные срезы?"

msgid "Видалити акаунт"
msgstr "Удалить аккаунт"

msgid "Цей акаунт не можна видалити."
msgstr "Этот аккаунт нельзя удалить."

msgid "Акаунт видалено."
msgstr "Аккаунт удален."

msgid "Зрізи, відповіді, нотатки, чернетка і прив'язані способи входу буде видалено. Це незворотно."
msgstr "Срезы, ответы, заметки, черновик и привязанные способы входа будут удалены. Это необратимо."

msgid "Реєстрація від"
msgstr "Регистрация от"

msgid "Реєстрація до"
msgstr "Регистрация до"

msgid "Ім'я, UID або адреса"
msgstr "Имя, UID или адрес"

msgid "Спробувати Premium 7 днів"
msgstr "Попробовать Premium 7 дней"

msgid "0 — зовсім не так, як хочу. 10 — саме так, як хочу."
msgstr "0 — совсем не так, как хочу. 10 — именно так, как хочу."

msgid "Орієнтир — частка тверджень, з якими ви погодились (частково = половина), переведена в шкалу 0–10."
msgstr "Ориентир — доля утверждений, с которыми вы согласились (частично = половина), переведенная в шкалу 0–10."

msgid "Деякі відповіді скинуто, бо формулювання критерію змінилось."
msgstr "Некоторые ответы сброшены, потому что формулировка критерия изменилась."

msgid "Сьогодні вже є збережений зріз."
msgstr "Сегодня уже есть сохраненный срез."

msgid "Оцінки"
msgstr "Оценки"

msgid "Зберегти чернетку"
msgstr "Сохранить черновик"

msgid "Зберегти зріз"
msgstr "Сохранить срез"

