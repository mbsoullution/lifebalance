msgid "Ключ може містити лише малі латинські літери, цифри, крапку, дефіс і підкреслення."
msgstr "Ключ может содержать только строчные латинские буквы, цифры, точку, дефис и подчеркивание."

msgid "Назва має містити від 1 до 80 символів."
msgstr "Название должно содержать от 1 до 80 символов."

msgid "Додайте текст рекомендації."
msgstr "Добавьте текст рекомендации."

msgid "Додайте від одного до пʼяти кроків."
msgstr "Добавьте от одного до пяти шагов."

msgid "Оберіть відповідь «Ні», «Частково» або обидві."
msgstr "Выберите ответ «Нет», «Частично» или оба."

msgid "Опублікувати або архівувати може лише людина з правом публікації."
msgstr "Опубликовать или архивировать может только человек с правом публикации."

msgid "Оберіть існуючу сферу."
msgstr "Выберите существующую сферу."

msgid "Вкажіть хоча б один критерій."
msgstr "Укажите хотя бы один критерий."

msgid "Критерій @key не існує."
msgstr "Критерий @key не существует."

msgid "Критерій @key належить іншій сфері."
msgstr "Критерий @key принадлежит другой сфере."

msgid "Сфера"
msgstr "Сфера"

msgid "Назва"
msgstr "Название"

msgid "Опис"
msgstr "Описание"

msgid "Кроки"
msgstr "Шаги"

msgid "Від одного до пʼяти коротких кроків."
msgstr "От одного до пяти коротких шагов."

msgid "Крок @number"
msgstr "Шаг @number"

msgid "Термін"
msgstr "Срок"

msgid "Можна лишити порожнім."
msgstr "Можно оставить пустым."

msgid "Додати ціль"
msgstr "Добавить цель"

msgid "Ціль додано до плану."
msgstr "Цель добавлена в план."

msgid "Нові цілі доступні з розширеним доступом."
msgstr "Новые цели доступны с расширенным доступом."

msgid "Активних цілей уже @limit. Завершіть або скасуйте одну, щоб додати нову."
msgstr "Активных целей уже @limit. Завершите или отмените одну, чтобы добавить новую."

msgid "Ціль не збережено. Перевірте назву, опис і кроки."
msgstr "Цель не сохранена. Проверьте название, описание и шаги."

msgid "Щоб побачити підказки, спочатку дайте відповіді в опитувальнику."
msgstr "Чтобы увидеть подсказки, сначала ответьте в опроснике."

msgid "Перейти до опитувальника"
msgstr "Перейти к опроснику"

msgid "Підказки для саморефлексії на основі ваших відповідей."
msgstr "Подсказки для саморефлексии на основе ваших ответов."

msgid "Сфери"
msgstr "Сферы"

msgid "Оберіть одну або дві сфери."
msgstr "Выберите одну или две сферы."

msgid "Найнижча оцінка в останньому зрізі."
msgstr "Самая низкая оценка в последнем срезе."

msgid "Показати підказки"
msgstr "Показать подсказки"

msgid "Оберіть від однієї до трьох підказок."
msgstr "Выберите от одной до трех подсказок."

msgid "План на 30 днів розпочато."
msgstr "План на 30 дней начат."

msgid "У розширеному доступі — персональний план і кроки."
msgstr "В расширенном доступе — персональный план и шаги."

msgid "Для цієї сфери поки немає готових рекомендацій. Ви можете додати власну ціль."
msgstr "Для этой сферы пока нет готовых рекомендаций. Вы можете добавить собственную цель."

msgid "Додати власну ціль"
msgstr "Добавить собственную цель"

msgid "Почати план на 30 днів"
msgstr "Начать план на 30 дней"

msgid "Це не медична порада. Якщо симптоми турбують, зверніться до лікаря."
msgstr "Это не медицинский совет. Если симптомы беспокоят, обратитесь к врачу."

msgid "Включити в план на 30 днів"
msgstr "Включить в план на 30 дней"

msgid "Додати до плану"
msgstr "Добавить в план"

msgid "Новий план доступний з розширеним доступом."
msgstr "Новый план доступен с расширенным доступом."

msgid "План на 30 днів уже триває."
msgstr "План на 30 дней уже идет."

msgid "Активних цілей уже @limit. Завершіть або скасуйте одну, щоб почати план."
msgstr "Активных целей уже @limit. Завершите или отмените одну, чтобы начать план."

msgid "План зараз не можна почати."
msgstr "План сейчас нельзя начать."

msgid "Ця підказка вже є серед активних цілей."
msgstr "Эта подсказка уже есть среди активных целей."

msgid "Для цієї відповіді поради не додаються."
msgstr "Для этого ответа советы не добавляются."

msgid "Цю підказку зараз не можна додати."
msgstr "Эту подсказку сейчас нельзя добавить."

msgid "Підтримка"
msgstr "Поддержка"

msgid "Блок підтримки"
msgstr "Блок поддержки"

msgid "Текст для чутливих критеріїв. Його побачить людина замість порад. Сюди можна додати контакти перевірених організацій."
msgstr "Текст для чувствительных критериев. Его увидит человек вместо советов. Сюда можно добавить контакты проверенных организаций."

msgid "Ліміт активних цілей"
msgstr "Лимит активных целей"

msgid "Скільки цілей зі статусом «Заплановано» або «У процесі» може бути одночасно. Від 1 до 10."
msgstr "Сколько целей со статусом «Запланировано» или «В процессе» может быть одновременно. От 1 до 10."

msgid "Чутливі критерії"
msgstr "Чувствительные критерии"

msgid "Ключі критеріїв, по одному на рядок. Якщо відповідь «Ні», поради для цього критерію не показуються."
msgstr "Ключи критериев, по одному на строку. Если ответ «Нет», советы для этого критерия не показываются."

msgid "Ліміт активних цілей має бути від 1 до 10."
msgstr "Лимит активных целей должен быть от 1 до 10."

msgid "Ключ критерію має складатися з малих латинських літер, цифр, крапки, дефіса або підкреслення."
msgstr "Ключ критерия должен состоять из строчных латинских букв, цифр, точки, дефиса или подчеркивания."

msgid "Налаштування збережено."
msgstr "Настройки сохранены."

msgid "Статус"
msgstr "Статус"

msgid "Оновити ціль"
msgstr "Обновить цель"

msgid "Ціль не оновлено."
msgstr "Цель не обновлена."

msgid "Кроки не оновлено."
msgstr "Шаги не обновлены."

msgid "Ціль оновлено."
msgstr "Цель обновлена."

msgid "Ключ не змінюється. Рекомендацію можна архівувати, видалити її неможливо."
msgstr "Ключ не меняется. Рекомендацию можно архивировать, удалить ее нельзя."

msgid "Наприклад, health.sleep.evening_wind_down."
msgstr "Например, health.sleep.evening_wind_down."

msgid "Ключ не змінюється."
msgstr "Ключ не меняется."

msgid "Рекомендація з таким ключем уже існує."
msgstr "Рекомендация с таким ключом уже существует."

msgid "Зберегти"
msgstr "Сохранить"

msgid "Рекомендацію збережено."
msgstr "Рекомендация сохранена."

msgid "Пройти нову самооцінку"
msgstr "Пройти новую самооценку"

msgid "Плану на 30 днів ще немає."
msgstr "Плана на 30 дней еще нет."

msgid "План на 30 днів до @date включно. Залишилось днів: @days."
msgstr "План на 30 дней до @date включительно. Осталось дней: @days."

msgid "Завершити достроково"
msgstr "Завершить досрочно"

msgid "Архів планів"
msgstr "Архив планов"

msgid "@status, до @date"
msgstr "@status, до @date"

msgid "План завершено достроково. Цілі залишаються."
msgstr "План завершен досрочно. Цели остаются."

msgid "План не завершено."
msgstr "План не завершен."

msgid "Версія для друку"
msgstr "Версия для печати"

msgid "У цьому переліку цілей ще немає."
msgstr "В этом перечне целей еще нет."

msgid "Підказки для саморефлексії"
msgstr "Подсказки для саморефлексии"

msgid "Активні"
msgstr "Активные"

msgid "30 днів"
msgstr "30 дней"

msgid "90 днів"
msgstr "90 дней"

msgid "Виконані/скасовані"
msgstr "Выполненные/отмененные"

msgid "Минуло @days днів від цілі у сфері «@sector». Переоцінити сферу?"
msgstr "Прошло @days дней с цели в сфере «@sector». Переоценить сферу?"

msgid "Переоцінити сферу «@sector»?"
msgstr "Переоценить сферу «@sector»?"

msgid "@sector · @status · до @due"
msgstr "@sector · @status · до @due"

msgid "Друк / Зберегти як PDF"
msgstr "Печать / Сохранить как PDF"

msgid "Без скриптів відкрийте друк у браузері й оберіть «Зберегти як PDF»."
msgstr "Без скриптов откройте печать в браузере и выберите «Сохранить как PDF»."

msgid "Зрізу ще немає."
msgstr "Среза еще нет."

msgid "Активні цілі"
msgstr "Активные цели"

msgid "Активних цілей ще немає."
msgstr "Активных целей еще нет."

msgid "План на 30 днів"
msgstr "План на 30 дней"

msgid "У цьому плані цілей ще немає."
msgstr "В этом плане целей еще нет."

msgid "Середнє: @average"
msgstr "Среднее: @average"

msgid "Сектор"
msgstr "Сектор"

msgid "Оцінка"
msgstr "Оценка"

msgid "Орієнтир"
msgstr "Ориентир"

