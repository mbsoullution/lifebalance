msgstr "Access from this payment has ended."

msgid "Оплату зараховано."
msgstr "The payment was recorded."

msgid "Оплата обробляється, ми надішлемо лист."
msgstr "The payment is being processed. We will send an email."

msgid "Оплату не завершено."
msgstr "The payment was not completed."

msgid "Частину оплати повернено."
msgstr "Part of the payment was refunded."

msgid "Перевіряємо оплату… Якщо підтвердження затримується, лист надійде після обробки."
msgstr "We are checking the payment… If confirmation is delayed, an email will arrive after processing."

msgid "Орієнтир перераховується на сервері."
msgstr "The guide is recalculated on the server."

msgid "Версія каталогу записується на сервері."
msgstr "The catalog version is recorded on the server."

msgid "Кожен активний сектор має оцінку."
msgstr "Every active sector has a score."

msgid "Оцінка сектору повторюється."
msgstr "The sector score is repeated."

msgid "Оцінка вказує на невідомий або вимкнений сектор."
msgstr "The score points to an unknown or disabled sector."

msgid "Відповідь на критерій повторюється."
msgstr "The criterion answer is repeated."

msgid "Відповідь приймається лише для опублікованого критерію з поточною ревізією."
msgstr "An answer is accepted only for a published criterion with the current revision."

msgid "Відповідь стосується сектору, якого немає серед активних."
msgstr "The answer refers to a sector that is not among the active ones."

msgid "Відповідь на розширений критерій потребує доступу до розширеного оцінювання."
msgstr "An answer to an extended criterion requires access to extended assessment."

msgid "Нотатка може містити не більше 1000 символів."
msgstr "A note can contain no more than 1000 characters."

