msgstr "@days days have passed since the goal in “@sector”. Reassess the area?"

msgid "Переоцінити сферу «@sector»?"
msgstr "Reassess the area “@sector”?"

msgid "@sector · @status · до @due"
msgstr "@sector · @status · until @due"

