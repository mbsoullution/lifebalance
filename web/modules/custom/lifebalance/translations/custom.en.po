msgstr "Link or unlink Google and Facebook. The last sign-in method stays."

msgid "Провайдери ще не прив'язані."
msgstr "No providers are linked yet."

msgid "Прив'язати Google"
msgstr "Link Google"

msgid "Прив'язати Facebook"
