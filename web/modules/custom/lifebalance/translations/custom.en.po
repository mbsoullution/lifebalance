msgstr "The refund was sent. The status will update after confirmation."

msgid "@price грн за @days днів"
msgstr "@price UAH for @days days"

msgid "Наступні 30 днів коштують @price грн."
msgstr "The next 30 days cost @price UAH."

msgid "Акційні місця закінчились. Ціна 149 грн за 30 днів"
msgstr "Promotional places are used up. The price is 149 UAH for 30 days"

msgid "Підтверджую оплату 149 грн за 30 днів"
msgstr "I confirm payment of 149 UAH for 30 days"

msgid "Підтвердьте оплату 149 грн за 30 днів."
msgstr "Confirm payment of 149 UAH for 30 days."

msgid "Доступ до @date включно."
msgstr "Access through @date."

msgid "Оплата почнеться @date, після поточного доступу."
msgstr "Payment starts on @date, after the current access."

msgid "Автопродовження немає."
msgstr "There is no auto-renewal."

msgid "Збережені зрізи, відповіді, цілі й плани лишаються."
msgstr "Saved snapshots, answers, goals, and plans remain."

msgid "Нові розширені дії будуть недоступні."
msgstr "New extended actions will be unavailable."

msgid "Умови повернення"
msgstr "Refund terms"

msgid "Безстроковий доступ уже є, тож нова оплата не потрібна."
msgstr "Unlimited access already exists, so a new payment is not needed."

msgid "Забагато спроб оплати. Спробуйте пізніше."
msgstr "Too many payment attempts. Try again later."

msgid "Перейти до оплати"
msgstr "Go to payment"

msgid "Частину оплати повернено. Доступ можна завершити вручну. Зрізи і цілі залишаються."
msgstr "Part of the payment was refunded. Access can be ended manually. Snapshots and goals remain."

msgid "Для цього замовлення рішення вже не потрібне."
msgstr "A decision is no longer needed for this order."

