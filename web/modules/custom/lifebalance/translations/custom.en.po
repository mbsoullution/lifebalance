msgid "Зміну не збережено. Перевірте дату і причину."
msgstr "The change was not saved. Check the date and the reason."

msgid "Зміну збережено."
msgstr "The change was saved."

msgid "Ключ не змінюється. Критерій можна архівувати, видалити його неможливо."
msgstr "The key does not change. A criterion can be archived, not deleted."

msgid "Наприклад, health.f01."
msgstr "For example, health.f01."

msgid "Критерій з таким ключем уже існує."
msgstr "A criterion with this key already exists."

msgid "Архівувати"
msgstr "Archive"

msgid "Критерій збережено."
msgstr "The criterion was saved."

msgid "Оцінювання"
