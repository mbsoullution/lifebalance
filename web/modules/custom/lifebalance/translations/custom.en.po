msgstr "The dispute was not marked."

msgid "Спір позначено, доступ завершено."
msgstr "The dispute was marked and access ended."

msgid "Повне повернення @price грн за «@plan». Часткове повернення тут не оформлюється."
msgstr "Full refund of @price UAH for “@plan”. A partial refund is not processed here."

msgid "Це замовлення не можна повернути звідси."
msgstr "This order cannot be refunded from here."

msgid "Повернути"
msgstr "Refund"

msgid "Повернення не прийнято."
msgstr "The refund was not accepted."

msgid "Оплату повернено."
msgstr "The payment was refunded."

