msgid "Ключ може містити лише малі латинські літери, цифри, крапку, дефіс і підкреслення."
msgstr "A key may contain only lowercase Latin letters, digits, a dot, a hyphen, and an underscore."

msgid "Назва має містити від 1 до 80 символів."
msgstr "The name must be 1 to 80 characters."

msgid "Додайте текст рекомендації."
msgstr "Add the recommendation text."

msgid "Додайте від одного до пʼяти кроків."
msgstr "Add one to five steps."

msgid "Оберіть відповідь «Ні», «Частково» або обидві."
msgstr "Choose the answer “No”, “Partly”, or both."

msgid "Опублікувати або архівувати може лише людина з правом публікації."
msgstr "Only a person with publishing permission can publish or archive."

msgid "Оберіть існуючу сферу."
msgstr "Choose an existing area."

msgid "Вкажіть хоча б один критерій."
msgstr "Specify at least one criterion."

msgid "Критерій @key не існує."
msgstr "Criterion @key does not exist."

msgid "Критерій @key належить іншій сфері."
msgstr "Criterion @key belongs to another area."

msgid "Сфера"
msgstr "Area"

msgid "Назва"
msgstr "Name"

msgid "Опис"
msgstr "Description"

msgid "Кроки"
msgstr "Steps"

msgid "Від одного до пʼяти коротких кроків."
msgstr "One to five short steps."

msgid "Крок @number"
msgstr "Step @number"

msgid "Термін"
msgstr "Due date"

msgid "Можна лишити порожнім."
msgstr "You can leave this empty."

msgid "Додати ціль"
msgstr "Add a goal"

msgid "Ціль додано до плану."
msgstr "The goal was added to the plan."

msgid "Нові цілі доступні з розширеним доступом."
msgstr "New goals are available with extended access."

msgid "Активних цілей уже @limit. Завершіть або скасуйте одну, щоб додати нову."
msgstr "There are already @limit active goals. Finish or cancel one to add another."

msgid "Ціль не збережено. Перевірте назву, опис і кроки."
msgstr "The goal was not saved. Check the name, description, and steps."

msgid "Щоб побачити підказки, спочатку дайте відповіді в опитувальнику."
msgstr "Answer the questionnaire first to see prompts."

msgid "Перейти до опитувальника"
msgstr "Go to the questionnaire"

msgid "Підказки для саморефлексії на основі ваших відповідей."
msgstr "Prompts for self-reflection based on your answers."

msgid "Сфери"
msgstr "Areas"

msgid "Оберіть одну або дві сфери."
msgstr "Choose one or two areas."

msgid "Найнижча оцінка в останньому зрізі."
msgstr "The lowest score in the latest snapshot."

msgid "Показати підказки"
msgstr "Show prompts"

msgid "Оберіть від однієї до трьох підказок."
msgstr "Choose one to three prompts."

msgid "План на 30 днів розпочато."
msgstr "The 30-day plan has started."

msgid "У розширеному доступі — персональний план і кроки."
msgstr "Extended access includes a personal plan and steps."

msgid "Для цієї сфери поки немає готових рекомендацій. Ви можете додати власну ціль."
msgstr "This area has no ready recommendations yet. You can add your own goal."

msgid "Додати власну ціль"
msgstr "Add your own goal"

msgid "Почати план на 30 днів"
msgstr "Start the 30-day plan"

msgid "Це не медична порада. Якщо симптоми турбують, зверніться до лікаря."
msgstr "This is not medical advice. If symptoms worry you, contact a doctor."

msgid "Включити в план на 30 днів"
msgstr "Include in the 30-day plan"

msgid "Додати до плану"
msgstr "Add to the plan"

msgid "Новий план доступний з розширеним доступом."
msgstr "A new plan is available with extended access."

msgid "План на 30 днів уже триває."
msgstr "A 30-day plan is already in progress."

msgid "Активних цілей уже @limit. Завершіть або скасуйте одну, щоб почати план."
msgstr "There are already @limit active goals. Finish or cancel one to start a plan."

msgid "План зараз не можна почати."
msgstr "The plan cannot be started right now."

msgid "Ця підказка вже є серед активних цілей."
msgstr "This prompt is already among the active goals."

msgid "Для цієї відповіді поради не додаються."
msgstr "No advice is added for this answer."

msgid "Цю підказку зараз не можна додати."
msgstr "This prompt cannot be added right now."

msgid "Підтримка"
msgstr "Support"

msgid "Блок підтримки"
msgstr "Support block"

msgid "Текст для чутливих критеріїв. Його побачить людина замість порад. Сюди можна додати контакти перевірених організацій."
msgstr "Text for sensitive criteria. A person sees it instead of advice. You can add contacts of verified organizations here."

msgid "Ліміт активних цілей"
msgstr "Active goal limit"

msgid "Скільки цілей зі статусом «Заплановано» або «У процесі» може бути одночасно. Від 1 до 10."
msgstr "How many goals with the status “Planned” or “In progress” can exist at once. From 1 to 10."

msgid "Чутливі критерії"
msgstr "Sensitive criteria"

msgid "Ключі критеріїв, по одному на рядок. Якщо відповідь «Ні», поради для цього критерію не показуються."
msgstr "Criterion keys, one per line. If the answer is “No”, advice for that criterion is not shown."

msgid "Ліміт активних цілей має бути від 1 до 10."
msgstr "The active goal limit must be from 1 to 10."

msgid "Ключ критерію має складатися з малих латинських літер, цифр, крапки, дефіса або підкреслення."
msgstr "A criterion key must consist of lowercase Latin letters, digits, a dot, a hyphen, or an underscore."

msgid "Налаштування збережено."
msgstr "Settings saved."

msgid "Статус"
msgstr "Status"

msgid "Оновити ціль"
msgstr "Update goal"

msgid "Ціль не оновлено."
msgstr "The goal was not updated."

msgid "Кроки не оновлено."
msgstr "The steps were not updated."

msgid "Ціль оновлено."
msgstr "The goal was updated."

msgid "Ключ не змінюється. Рекомендацію можна архівувати, видалити її неможливо."
msgstr "The key does not change. A recommendation can be archived, not deleted."

msgid "Наприклад, health.sleep.evening_wind_down."
msgstr "For example, health.sleep.evening_wind_down."

msgid "Ключ не змінюється."
msgstr "The key does not change."

msgid "Рекомендація з таким ключем уже існує."
msgstr "A recommendation with this key already exists."

msgid "Зберегти"
msgstr "Save"

msgid "Рекомендацію збережено."
msgstr "The recommendation was saved."

msgid "Пройти нову самооцінку"
msgstr "Take a new self-assessment"

msgid "Плану на 30 днів ще немає."
msgstr "There is no 30-day plan yet."

msgid "План на 30 днів до @date включно. Залишилось днів: @days."
msgstr "The 30-day plan runs through @date. Days left: @days."

msgid "Завершити достроково"
msgstr "Finish early"

msgid "Архів планів"
msgstr "Plan archive"

msgid "@status, до @date"
msgstr "@status, until @date"

msgid "План завершено достроково. Цілі залишаються."
msgstr "The plan was finished early. The goals remain."

msgid "План не завершено."
msgstr "The plan was not finished."

msgid "Версія для друку"
msgstr "Print version"

msgid "У цьому переліку цілей ще немає."
msgstr "This list has no goals yet."

