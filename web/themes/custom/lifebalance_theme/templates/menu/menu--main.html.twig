{#
/**
 * @file
 * Main menu. A parent with children opens a list and stays a link.
 */
#}
{{ _self.links(items, attributes, '', null) }}

{% macro links(items, attributes, parent_title, parent_url) %}
  {% if items %}
    {% if attributes %}
      <ul{{ attributes.addClass('navbar-nav') }}>
    {% else %}
      <ul class="lifebalance-menu__sub">
        <li class="lifebalance-menu__back">
          <button type="button" class="lifebalance-menu__backbutton" aria-label="{{ 'Назад'|t }}"></button>
          {% if parent_url %}
            {{ link(parent_title, parent_url, { 'class': ['lifebalance-menu__sublink'] }) }}
          {% endif %}
        </li>
    {% endif %}
    {% for item in items %}
      {% set item_classes = ['nav-item'] %}
      {% if item.below %}
        {% set item_classes = item_classes|merge(['lifebalance-menu__branch']) %}
      {% endif %}
      {% if item.in_active_trail %}
        {% set item_classes = item_classes|merge(['active']) %}
      {% endif %}
      {% set link_classes = attributes ? ['nav-link'] : ['lifebalance-menu__sublink'] %}
      {% if item.in_active_trail %}
        {% set link_classes = link_classes|merge(['active']) %}
      {% endif %}
      <li{{ item.attributes.addClass(item_classes) }}>
        {{ link(item.title, item.url, { 'class': link_classes }) }}
        {% if item.below %}
          <button type="button" class="lifebalance-menu__toggle" aria-expanded="false" aria-label="{{ 'Відкрити підменю'|t }}"></button>
          {{ _self.links(item.below, false, item.title, item.url) }}
        {% endif %}
      </li>
    {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
