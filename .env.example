# Copy to .env. .env is gitignored.
# Leave DRUPAL_DB_HOST empty on DDEV so settings.ddev.php supplies the database.

DRUPAL_DB_HOST=
DRUPAL_DB_NAME=db
DRUPAL_DB_USER=db
DRUPAL_DB_PASSWORD=db
DRUPAL_DB_PORT=3306
HASH_SALT=

# OAuth client secrets. Leave empty until the apps exist. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
